{
  "version": 2,
  "builds": [{ "src": "api/index.ts", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.ts" }],
  "crons": [
    { "path": "/api/v1/internal/cron/payouts", "schedule": "0 6 * * *" },
    { "path": "/api/v1/internal/cron/reminders", "schedule": "0 7 * * *" }
  ]
}
