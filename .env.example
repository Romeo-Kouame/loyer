PORT=3000
NODE_ENV=development

# Port 5433 (not the default 5432) to avoid clashing with a locally installed Postgres
DATABASE_URL=postgresql://user:password@localhost:5433/loyers_db
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=loyers_db

REDIS_URL=redis://localhost:6379

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# K-Pay aggregator (https://kpay.site) - covers MTN/Orange Money in Côte d'Ivoire
KPAY_API_KEY=kpay_test_your-api-key
KPAY_SECRET_KEY=sk_test_your-secret-key
KPAY_BASE_URL=https://admin.kpay.site
# From the K-Pay dashboard's webhook settings, used to verify webhook signatures
KPAY_WEBHOOK_SECRET=your-kpay-webhook-secret

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Days after a due date before a lease balance is considered late
RENT_GRACE_PERIOD_DAYS=5

# Platform commission taken from each confirmed payment before payout (0.04 = 4%)
PAYOUT_COMMISSION_RATE=0.04
# Hours to wait after payment confirmation before attempting the payout (dispute window)
PAYOUT_RESERVE_HOLD_HOURS=48

# SMTP for email notifications (receipts, KYC/verification decisions, dispute resolution).
# Left empty locally: emails are skipped (logged only) rather than failing the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

LOG_LEVEL=debug
